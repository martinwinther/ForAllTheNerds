# BigWigs packager configuration.
# Reference: https://github.com/BigWigsMods/packager
#
# The addon's .toc sits at the repository root, which is what the packager
# expects. Everything that is tooling rather than addon gets ignored below.

package-as: ForAllTheNerds

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

ignore:
    - tools
    - README.md
    - INSTALL.md
    - PUBLISHING.md
    - curseforge-description.md
    - media

# Note: the packager always ignores anything beginning with a period, so
# .pkgmeta, .github and .gitignore need no entry here.
#
# No externals: this addon deliberately embeds no libraries, so there is
# nothing to fetch at package time.
