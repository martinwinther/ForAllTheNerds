# Copy this file to .env and fill in the two values.
#
#     cp .env.example .env
#     chmod 600 .env
#
# .env is gitignored and must stay that way. This file, the example, is the
# only one of the pair that is committed, and it holds no real values.
#
# Make a client at https://develop.battle.net under API Access. Two-factor
# authentication has to be on the Battle.net account first, or the portal will
# not let you create one. Used by tools/blizzard-ids.py; see tools/npc-ids.md
# for what that can and cannot answer.

BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Optional. Defaults to us. One of us, eu, kr, tw.
# BLIZZARD_REGION=us

# Optional. Defaults to static-classic1x-<region>, which is Classic Era.
# There is no Forever namespace, so do not go looking for one.
# BLIZZARD_NAMESPACE=static-classic1x-us
